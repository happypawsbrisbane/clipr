# Copy to .env.local for local development. Vercel and other hosts
# should set these in their dashboard / project settings.

# Required only if you want to access /admin to moderate offers.
# Any non-empty string enables the admin login. Pick something strong.
ADMIN_PASSWORD=

# Verification reports (votes on whether a coupon worked) persist to
# this database when set. Leave blank to fall back to an in-memory
# store seeded from data/reports.seed.json (fine for local dev or tests).
#
# Local dev (SQLite — path is relative to prisma/schema.prisma):
#   DATABASE_URL="file:./dev.db"
#
# Production (Postgres on Vercel/Neon/Supabase/Railway): switch the
# datasource provider in prisma/schema.prisma to "postgresql", then:
#   DATABASE_URL="postgres://user:pass@host:5432/dbname"
DATABASE_URL=
